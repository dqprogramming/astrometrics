# Copy to .env and fill in values before deploying.
# Never commit .env to version control.

# --- Django core --------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Comma-separated origins (https://...) Django should trust for CSRF.
# Required when serving over HTTPS through a reverse proxy.
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Database -----------------------------------------------------------
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Email --------------------------------------------------------------
# Default is the console backend, suitable for dev. For production set
# EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend. SMTP host
# / port / credentials are NOT read from env by settings.py at present;
# add EMAIL_HOST etc. to settings.py first if you need them.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# --- Sentry (optional) --------------------------------------------------
SENTRY_DSN=
